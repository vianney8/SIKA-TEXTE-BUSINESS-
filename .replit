modules = ["nodejs-20", "web", "nix", "python-base-3.13", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["node", "./dist/index.js"]

[env]
PORT = "5000"

[agent]
integrations = ["javascript_database:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_object_storage:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]
expertMode = true
stack = "FULLSTACK_JS"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[userenv]

[userenv.shared]
# Keep credentials in Replit Secrets, never in this project file.
PRIVATE_OBJECT_DIR = "/FairInfantileAddons"
PUBLIC_OBJECT_SEARCH_PATHS = "/FairInfantileAddons"
RESEND_FROM_EMAIL = "support@sikatexte.site"
PORT = "5000"

[objectStorage]
defaultBucketID = "replit-objstore-8ec8422d-72f4-48ba-b6e4-98b8904293d6"

[[ports]]
localPort = 5000
externalPort = 80
